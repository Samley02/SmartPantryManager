<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="Alerts">
        <SwitchPreferenceCompat
            app:key="pref_expiring_alerts"
            app:title="Expiring-soon alerts"
            app:summary="Highlight ingredients that are close to their expiry date"
            app:defaultValue="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Units">
        <ListPreference
            app:key="pref_unit_system"
            app:title="Preferred unit system"
            app:summary="%s"
            app:entries="@array/unit_entries"
            app:entryValues="@array/unit_values"
            app:defaultValue="metric" />
    </PreferenceCategory>

</PreferenceScreen>